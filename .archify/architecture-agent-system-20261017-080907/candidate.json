  "cards": [
    {
      "dot": "cyan",
      "title": "Trust model",
      "items": [
        "Core under src/ is small and fixed; only the owner edits it — that is the whole trust argument.",
        "Plugins are untrusted out-of-process binaries; the host spawns, inspects and talks to them over JSON-RPC.",
        "Tool output returns as data for the next prompt — the prompt never executes it."
      ]
    },
    {
      "dot": "emerald",
      "title": "Main path (stages 1–6)",
      "items": [
        "CLI enqueues one event; the Runner drives plan → act → observe → verify → summarize in a single session.",
        "Every tool call is checked by the Gate before it runs; plugins execute in their own sandbox.",
        "The session log is append-only; context and history are derived views rebuilt on resume."
      ]
    },
    {
      "dot": "rose",
      "title": "Approvals & verification",
      "items": [
        "Irreversible actions ask the owner, or answer from rules via Delegate; the daemon owns the approval queue.",
        "A read-only verifier with fresh context re-checks any claim of 'done' before it is accepted.",
        "check_exec runs the owner's checks with no network and an empty environment."
      ]
    },
    {
      "dot": "violet",
      "title": "Self-upgrade pipeline",
      "items": [
        "The agent proposes plugin upgrades; the owner runs static → contract → eval → canary → approve → deploy.",
        "Snapshots live in the agent home; rollback restores the previous version in one step.",
        "Spend budgets and caps are enforced by the core, never by a plugin."
      ]
    }
  ]
